---
import { getStudentProjects } from '../lib/github';

// 取得したプロジェクト一覧をビルド時にランダムにシャッフル
const allProjects = (await getStudentProjects()).sort(() => Math.random() - 0.5);

// Topics に 'featured-2026' が含まれる作品を優秀作品として抽出
const featuredProjects = allProjects.filter((project) =>
  project.topics?.includes('featured-2026')
);

// それ以外の作品
const regularProjects = allProjects.filter(
  (project) => !project.topics?.includes('featured-2026')
);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Work Gallery 2026</title>
  </head>
  <body class="bg-yellow-300 text-gray-900 p-4 sm:p-6 md:p-12 min-h-screen">
    {/* ヘッダー */}
    <header class="max-w-7xl mx-auto mb-10 sm:mb-16 text-center md:text-left">
      <span class="inline-block text-lg sm:text-2xl font-bold bg-gray-50 text-gray-900 tracking-wide px-4 sm:px-6 py-2.5 sm:py-3 rounded-full border border-gray-50 shadow-sm">
        🎨 STUDENT WORK GALLERY
      </span>
    </header>

    <main class="max-w-7xl mx-auto space-y-12 sm:space-y-16">

      {/* ================= 優秀作品 (Featured Section) ================= */}
      {featuredProjects.length > 0 && (
        <section class="space-y-4 sm:space-y-6">
          <div class="flex flex-wrap items-center gap-2 sm:gap-3 border-b border-amber-500/30 pb-3">
            <span class="text-xl sm:text-2xl">🏆</span>
            <h2 class="text-xl sm:text-2xl font-bold text-gray-700 tracking-wide">
              FEATURED WORKS
            </h2>
            <span class="bg-rose-500/20 text-rose-600 text-xs font-semibold px-2.5 py-1 rounded-full border border-rose-500/60">
              ピックアップ作品
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
            {featuredProjects.map((project) => {
              const screenshotUrl = `https://api.microlink.io/?url=${encodeURIComponent(project.homepage)}&screenshot=true&embed=screenshot.url`;

              return (
                <article class="relative bg-gradient-to-b from-gray-900 to-gray-950 border-2 border-amber-500/40 rounded-2xl overflow-hidden shadow-2xl shadow-amber-500/10 hover:border-amber-400 transition-all duration-300 group flex flex-col">
                  {/* 優秀作品バッジ */}
                  <div class="absolute top-3 right-3 sm:top-4 sm:right-4 z-10 bg-gradient-to-r from-amber-500 to-orange-500 text-black text-[10px] sm:text-xs font-black px-2.5 py-1 rounded-full shadow-md uppercase tracking-wider">
                    ★ Featured
                  </div>

                  <div class="aspect-video w-full bg-gray-800 overflow-hidden relative">
                    <img 
                      src={screenshotUrl} 
                      alt={project.name} 
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                      loading="lazy"
                    />
                  </div>
                  
                  <div class="p-5 sm:p-7 flex-1 flex flex-col justify-between space-y-4 sm:space-y-6">
                    <div>
                      {/* メタ情報：ユーザー名 / リポジトリ名 */}
                      <div class="flex items-center space-x-2 mb-3 min-w-0 text-xs text-gray-400 font-mono">
                        <img src={project.owner.avatar_url} class="w-5 h-5 rounded-full border border-gray-700 shrink-0" />
                        <span class="truncate">@{project.owner.login} / <span class="text-gray-500">{project.name}</span></span>
                      </div>

                      {/* 主役：Description */}
                      <p class="text-white text-base sm:text-lg font-medium leading-relaxed line-clamp-4 group-hover:text-amber-200 transition">
                        {project.description || '説明なし'}
                      </p>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border
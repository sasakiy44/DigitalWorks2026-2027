---
import { getStudentProjects } from '../lib/github';

const allProjects = await getStudentProjects();

// Topics に 'featured-2026' が含まれる作品を優秀作品として抽出
const featuredProjects = allProjects.filter((project) =>
  project.topics?.includes('featured-2026')
);

// それ以外の作品
const regularProjects = allProjects.filter(
  (project) => !project.topics?.includes('featured-2026')
);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Work Gallery 2026</title>
  </head>
  <body class="bg-yellow-300 text-gray-900 p-6 md:p-12 min-h-screen">
    <header class="max-w-6xl mx-auto mb-16 text-center md:text-left">
      <span class="text-2xl font-semibold bg-gray-50 text-gray-900 px-4 py-2 rounded-full border border-gray-900">
        Student Work Gallery
      </span>
    </header>

    <main class="max-w-6xl mx-auto space-y-16">

      {/* ================= 優秀作品 (Featured Section) ================= */}
      {featuredProjects.length > 0 && (
        <section class="space-y-6">
          <div class="flex items-center space-x-3 border-b border-amber-500/30 pb-3">
            <span class="text-2xl">🏆</span>
            <h2 class="text-2xl font-bold text-gray-700 tracking-wide">
              FEATURED WORKS
            </h2>
            <span class="bg-rose-500/20 text-rose-600 text-xs font-semibold px-2.5 py-1 rounded-full border border-rose-500/60">
              ピックアップ作品
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {featuredProjects.map((project) => {
              const screenshotUrl = `https://api.microlink.io/?url=${encodeURIComponent(project.homepage)}&screenshot=true&embed=screenshot.url`;

              return (
                <article class="relative bg-gradient-to-b from-gray-900 to-gray-950 border-2 border-amber-500/40 rounded-2xl overflow-hidden shadow-2xl shadow-amber-500/10 hover:border-amber-400 transition-all duration-300 group flex flex-col">
                  {/* 優秀作品バッジ */}
                  <div class="absolute top-4 right-4 z-10 bg-gradient-to-r from-amber-500 to-orange-500 text-black text-xs font-black px-3 py-1 rounded-full shadow-md uppercase tracking-wider">
                    ★ Featured
                  </div>

                  <div class="aspect-video w-full bg-gray-800 overflow-hidden relative">
                    <img 
                      src={screenshotUrl} 
                      alt={project.name} 
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                      loading="lazy"
                    />
                  </div>
                  
                  <div class="p-7 flex-1 flex flex-col justify-between space-y-6">
                    <div>
                      <div class="flex items-center space-x-3 mb-3">
                        <img src={project.owner.avatar_url} class="w-8 h-8 rounded-full border border-gray-700" />
                        <span class="text-sm text-gray-300 font-mono">@{project.owner.login}</span>
                      </div>
                      <h3 class="text-2xl font-bold text-white group-hover:text-amber-300 transition">
                        {project.name}
                      </h3>
                      <p class="text-gray-300 text-sm mt-2 line-clamp-3 leading-relaxed">
                        {project.description || '説明なし'}
                      </p>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-gray-800/80">
                      <a 
                        href={project.homepage} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="px-5 py-2.5 bg-amber-500 hover:bg-amber-400 text-black text-xs font-bold rounded-xl transition shadow-lg shadow-amber-500/20"
                      >
                        サイトを見る ↗
                      </a>
                      <a 
                        href={project.html_url} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="text-xs text-gray-400 hover:text-white transition font-mono"
                      >
                        GitHub ↗
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}

      {/* ================= 通常作品 (Regular Section) ================= */}
      <section class="space-y-6">
        <div class="flex items-center space-x-3 border-b border-gray-800 pb-3">
          <span class="text-xl">🚀</span>
          <h2 class="text-xl font-bold text-gray-700 tracking-wide">
            ALL PROJECTS
          </h2>
          <span class="text-xs text-gray-500 font-mono">
            ({regularProjects.length})
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {regularProjects.map((project) => {
            const screenshotUrl = `https://api.microlink.io/?url=${encodeURIComponent(project.homepage)}&screenshot=true&embed=screenshot.url`;

            return (
              <article class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden shadow-lg hover:border-indigo-500/60 transition duration-300 flex flex-col group">
                <div class="aspect-video w-full bg-gray-800 overflow-hidden">
                  <img 
                    src={screenshotUrl} 
                    alt={project.name} 
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                    loading="lazy"
                  />
                </div>
                
                <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                  <div>
                    <div class="flex items-center space-x-2 mb-3">
                      <img src={project.owner.avatar_url} class="w-6 h-6 rounded-full" />
                      <span class="text-xs text-gray-400 font-mono">@{project.owner.login}</span>
                    </div>
                    <h3 class="text-lg font-bold text-white group-hover:text-indigo-400 transition">
                      {project.name}
                    </h3>
                    <p class="text-gray-400 text-xs mt-1 line-clamp-2">
                      {project.description || '説明なし'}
                    </p>
                  </div>

                  <div class="flex items-center justify-between pt-3 border-t border-gray-800">
                    <a 
                      href={project.homepage} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="px-3 py-1.5 bg-gray-200 hover:bg-gray-400 text-black text-xs font-semibold rounded-lg transition"
                    >
                      サイトを見る ↗
                    </a>
                    <a 
                      href={project.html_url} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-xs text-gray-500 hover:text-gray-300 transition"
                    >
                      GitHub ↗
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>

    </main>
  </body>
</html>